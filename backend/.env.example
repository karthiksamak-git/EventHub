# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or a local mongod instance)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventhub?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────────────────
# Use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Include every deployed origin (production domain, preview deployments, etc.).
CLIENT_URL=http://localhost:3000
# CLIENT_URLS=https://eventhub.vercel.app,https://eventhub-preview.vercel.app
