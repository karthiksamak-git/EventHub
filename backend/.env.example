# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or a local mongod instance)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventhub?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────────────────
# Use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-free single origin of the deployed frontend, e.g. https://eventhub.vercel.app
CLIENT_URL=http://localhost:3000
